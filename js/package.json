{
  "name": "warrantai",
  "version": "0.11.0-dev.0",
  "description": "Warrant: the decision ledger for AI agents. Record every consequential agent action with its mandate, evidence, cost and outcome, and replay real decisions before you ship a change.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./policy": {
      "types": "./src/policy.d.ts",
      "default": "./src/policy.js"
    },
    "./adapters/temporal": {
      "types": "./src/adapters/temporal.d.ts",
      "default": "./src/adapters/temporal.js"
    },
    "./schema": "./schema/decision-record.v0.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "warrant": "bin/warrant.js"
  },
  "files": [
    "bin",
    "src",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/schema.test.js test/cli.test.js test/sdk.test.js test/emit.test.js test/sink.test.js test/policy.test.js test/adapter-temporal.test.js test/adr.test.js test/admissibility.test.js test/adr-l2.test.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "keywords": [
    "ai-agents",
    "audit",
    "decision-records",
    "governance",
    "llm",
    "observability",
    "policy"
  ],
  "homepage": "https://warrantai.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warrant-ai/warrant.git",
    "directory": "js"
  },
  "bugs": {
    "url": "https://github.com/warrant-ai/warrant/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./src/index.d.ts",
  "devDependencies": {
    "@marcbachmann/cel-js": "^8.0.0",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/testing": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.0",
    "yaml": "^2.4.0"
  },
  "peerDependencies": {
    "@marcbachmann/cel-js": "^8.0.0",
    "@temporalio/activity": "^1.24.0",
    "yaml": "^2.4.0"
  },
  "peerDependenciesMeta": {
    "@marcbachmann/cel-js": {
      "optional": true
    },
    "@temporalio/activity": {
      "optional": true
    },
    "yaml": {
      "optional": true
    }
  }
}
