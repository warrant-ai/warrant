{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantai.dev/schema/decision-record.v0.json",
  "title": "Warrant decision record",
  "description": "One consequential action taken by an AI agent, with the mandate that allowed it, the evidence used, the cost, and the outcome once known. Records are append-only; outcomes, human verdicts and corrections are separate records that reference the original decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "record_type",
    "tenant",
    "stream",
    "timestamp",
    "schema_version",
    "origin"
  ],
  "properties": {
    "record_id": {
      "$ref": "#/$defs/ulid"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "decision",
        "outcome",
        "human_verdict",
        "correction",
        "transition"
      ]
    },
    "tenant": {
      "type": "string",
      "minLength": 1
    },
    "stream": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "schema_version": {
      "type": "string",
      "const": "0"
    },
    "origin": {
      "type": "string",
      "enum": [
        "live",
        "imported"
      ],
      "description": "live: emitted by the SDK at decision time. imported: reconstructed from an existing trace export by `warrant import`; never presented as sealed live evidence."
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_record_id"
      ],
      "properties": {
        "decision_record_id": {
          "$ref": "#/$defs/ulid"
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "instance": {
          "type": "string"
        },
        "on_behalf_of": {
          "type": "string",
          "description": "The human or system principal the agent acts for."
        },
        "model": {
          "type": "string",
          "description": "Model the agent ran on, as the runtime reported it."
        },
        "runtime": {
          "type": "string",
          "description": "Agent runtime or framework, e.g. temporal, langgraph."
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "registry",
            "id"
          ],
          "description": "The agent's entry in an external registry the relying party recognises (ADR 1.1).",
          "properties": {
            "registry": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "uri": {
              "type": "string"
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "action",
        "subject"
      ],
      "properties": {
        "class": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
          "description": "Customer-defined taxonomy, e.g. credit.approve"
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "acted",
            "withheld",
            "failed"
          ],
          "description": "acted: the action was performed. withheld: the decision scope closed without acting (for example a deny routed to a human). failed: an exception left the scope before the action."
        },
        "inputs": {
          "type": "object",
          "description": "The inputs the decision was made on, captured only when the SDK is configured with capture_inputs (development and staging). Needed for replay."
        },
        "route": {
          "type": "string",
          "enum": [
            "auto",
            "human",
            "model",
            "deferred"
          ],
          "description": "Where the policy sent this decision. auto: the agent acted on its own authority. human: a person was asked. model: a second, stronger model was asked. deferred: neither, try again later. Distinct from action, which is what was decided."
        },
        "question_set": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "description": "The registered, versioned set of questions this decision was made by answering. Stamped on every record so a reliability curve can be scoped to one version and a silent edit cannot invalidate a historical comparison.",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
              "description": "Semantic version. A question removed, renamed, or with its permitted values narrowed is a major bump."
            }
          }
        },
        "state_digest": {
          "$ref": "#/$defs/sha256",
          "description": "Hash of the exact state the decision was made on, canonicalised before hashing. The chain proves the state was not altered; state_ref allows replay."
        },
        "state_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Pointer to the retained state snapshot, never the snapshot itself. Snapshots carry their own retention and residency and can be redacted without breaking the chain."
        },
        "answers": {
          "type": "array",
          "description": "Typed answers the decision was composed from, with the full distribution rather than the winning value. Reliability analysis is impossible without the runners-up.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "value"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1,
                "description": "Key of the question within the question set."
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Stated probability for value. Absent when the answering model gives none; calibration can only measure answers that carry one."
              },
              "distribution": {
                "type": "array",
                "description": "Full categorical distribution. Omitted for continuous primitives.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "value",
                    "p"
                  ],
                  "properties": {
                    "value": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    },
                    "p": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              }
            }
          }
        },
        "claims": {
          "type": "array",
          "description": "What the agent asserts. Never evidence (ADR 1.2).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim"
            ],
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "value": {}
            }
          }
        }
      }
    },
    "mandate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result"
      ],
      "properties": {
        "policy_id": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "clause": {
          "type": "string"
        },
        "result": {
          "type": "string",
          "enum": [
            "allow",
            "deny",
            "escalate",
            "unchecked"
          ]
        },
        "reason": {
          "type": "string",
          "description": "Why the result was reached: the matching clause title, 'no clause matched', or the evaluation error under a fail mode."
        },
        "flagged": {
          "type": "boolean",
          "description": "True when the result came from a fail mode (fail-open or fail-escalate) rather than a clause, so reviewers can sample it."
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "uri",
          "content_hash"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Caller-chosen label, e.g. bureau_pull."
          },
          "type": {
            "type": "string",
            "enum": [
              "model_call",
              "tool_call",
              "document",
              "web",
              "other",
              "record",
              "mandate",
              "attestation",
              "human_review"
            ]
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "content_hash": {
            "$ref": "#/$defs/sha256"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "excerpt": {
            "type": "string",
            "description": "Opt-in, redacted before leaving the process."
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "description": "Who produced the item. 'self' or the actor's own name marks it self-attested."
          },
          "obligation": {
            "type": "string",
            "minLength": 1,
            "description": "Obligation id this item is offered against. Absent for inputs."
          },
          "admission": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "admitted",
                  "rejected"
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          },
          "salted": {
            "type": "boolean",
            "description": "content_hash is SHA-256(salt || content); the salt lives in the issuer's sidecar (ADR 4)."
          },
          "parent": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "record_id",
              "hash"
            ],
            "properties": {
              "record_id": {
                "$ref": "#/$defs/ulid"
              },
              "hash": {
                "$ref": "#/$defs/sha256"
              },
              "issuer": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "human": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reviewer": {
          "type": "string"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "approve",
            "reject",
            "amend"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": "string"
        },
        "shown": {
          "type": "array",
          "description": "Digests of the exact material the reviewer was shown (ADR rule 7).",
          "items": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "cost_centre": {
          "type": "string"
        },
        "breakdown": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "amount"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "model_call",
                  "tool_call",
                  "other"
                ]
              },
              "provider": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "tokens_in": {
                "type": "integer",
                "minimum": 0
              },
              "tokens_out": {
                "type": "integer",
                "minimum": 0
              },
              "amount": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "observed"
          ]
        },
        "label": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prev_hash",
        "hash"
      ],
      "properties": {
        "prev_hash": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ],
          "description": "null only for the first record in a stream."
        },
        "hash": {
          "$ref": "#/$defs/sha256"
        },
        "checkpoint": {
          "type": "integer",
          "minimum": 0
        },
        "signature": {
          "type": "string",
          "description": "base64 Ed25519 signature over 'adr/0.2 seal\\n' + hash (ADR 5.1)."
        },
        "key_id": {
          "type": "string",
          "pattern": "^ed25519:[a-f0-9]{16}$",
          "description": "Issuer key that produced signature."
        }
      }
    },
    "obligations": {
      "type": "array",
      "description": "What had to be true for this decision, from the relying organisation's policy (ADR 1.4).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requires",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "clause": {
            "type": "string"
          },
          "policy_id": {
            "type": "string"
          },
          "policy_version": {
            "type": "string"
          },
          "requires": {
            "type": "string",
            "enum": [
              "model_call",
              "tool_call",
              "document",
              "web",
              "other",
              "record",
              "mandate",
              "attestation",
              "human_review"
            ]
          },
          "name": {
            "type": "string"
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "max_age_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "type": "string",
            "enum": [
              "verifiable",
              "advisory"
            ]
          },
          "met": {
            "type": "boolean"
          },
          "satisfied_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "description": "Lifecycle state reached and who decided it (ADR 3). Recomputable by a verifier.",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "proposed",
            "pending_evidence",
            "escalated",
            "warranted",
            "refused",
            "committed"
          ]
        },
        "decided_by": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "from_state": {
          "type": "string",
          "enum": [
            "proposed",
            "pending_evidence",
            "escalated",
            "warranted",
            "refused",
            "committed"
          ],
          "description": "On a transition record: the state being left."
        },
        "reason": {
          "type": "string"
        },
        "met": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unmet": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "at"
            ],
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "proposed",
                  "pending_evidence",
                  "escalated",
                  "warranted",
                  "refused",
                  "committed"
                ]
              },
              "at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "parents": {
      "type": "array",
      "description": "Upstream records this decision relies on (ADR rule 5).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "hash"
        ],
        "properties": {
          "record_id": {
            "$ref": "#/$defs/ulid"
          },
          "hash": {
            "$ref": "#/$defs/sha256"
          },
          "issuer": {
            "type": "string"
          },
          "key_id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "proposed",
              "pending_evidence",
              "escalated",
              "warranted",
              "refused",
              "committed"
            ]
          }
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "type": "string",
          "minLength": 1
        },
        "retain_until": {
          "type": "string",
          "format": "date-time"
        },
        "legal_hold": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "decision"
          }
        }
      },
      "then": {
        "required": [
          "actor",
          "decision",
          "mandate"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "outcome"
          }
        }
      },
      "then": {
        "required": [
          "references",
          "outcome"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "human_verdict"
          }
        }
      },
      "then": {
        "required": [
          "references",
          "human"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "correction"
          }
        }
      },
      "then": {
        "required": [
          "references"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "transition"
          }
        }
      },
      "then": {
        "required": [
          "references",
          "verdict"
        ]
      }
    }
  ],
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
